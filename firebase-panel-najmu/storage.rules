rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Wyjątek dla gościa zalogowanego wyłącznie hasłem do jednego protokołu
    // — patrz analogiczny komentarz w firestore.rules. Dzięki temu zdjęcia,
    // podpis, mapa uszkodzeń i PDF trafiają do Storage nawet gdy najemca nie
    // jest zalogowany do panelu, tylko do tego jednego protokołu.
    match /rentals/{rentalId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        (!('protocolAccess' in request.auth.token) || request.auth.token.protocolAccess == rentalId);
    }
    // Dokumentacja zdjęciowa uszkodzeń pojazdu — stała, niezależna od
    // konkretnego wynajmu (baza pojazdów w panelu najmu).
    match /vehicles/{plateId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Własne (podmienione przez pracownika) szablony umów .docx — patrz
    // wireContractTemplateManager w js/app.js i generateContractDocx w
    // js/contracts.js. Prywatne — umowy nie są przeznaczone do publicznego
    // podglądu, tylko do generowania z panelu.
    match /contract-templates/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Obrazki wyróżniające wpisów bloga — publicznie czytelne (są osadzane
    // na iglo-bus.rent/blog dla niezalogowanych odwiedzających), zapis tylko
    // z panelu najmu.
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Zbiorczy plik .xlsx z aplikacjami o pracę (iglo-bus.rent/praca),
    // dopisywany wierszami przez Cloud Function przy każdym nowym zgłoszeniu.
    // Odczyt tylko zalogowany (Admin SDK w funkcji i tak omija te reguły).
    match /recruitment/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
